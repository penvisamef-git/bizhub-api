api_port=8086

# MongoDB Atlas
MONGO_USER=
MONGO_PASS=
MONGO_DB=bizhub
# Optional: use another MongoDB instead of Atlas (e.g. mongodb://127.0.0.1:27017/bizhub)
MONGO_URI=

# Every request must send this in the header:  x-api-key: <API_AUTH_KEY>
API_AUTH_KEY=
# Long random string used to sign login tokens
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bizhub

# First super admin (used once by: npm run seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Telegram bot (restaurant "Telegram" add-on: daily report + website messages to the owner's Telegram)
# 1. create a bot with @BotFather → paste its token and @name (without @)
# 2. live server: set API_PUBLIC_URL to the https address of this API (on Vercel it's found by itself),
#    restart → the bot is connected by itself. Check it: super admin → Website settings → Telegram bot.
# 3. your computer: nothing else needed (it asks Telegram for messages) — but use a SEPARATE test bot,
#    so the live bot keeps working.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
API_PUBLIC_URL=
# optional
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING=

# Daily sales report to Telegram: a scheduler calls GET /api/cron/daily-report every 15–60 minutes
# with header "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it by itself) or ?key=<CRON_SECRET>
CRON_SECRET=

# Phone sign-up (SMS code by Google Firebase Authentication)
# Firebase console → Project settings → General → "Project ID". Only this is needed here:
# the API checks Firebase's signed token with Google's public keys.
FIREBASE_PROJECT_ID=
